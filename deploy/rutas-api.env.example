# Copiar a /etc/viaja/rutas-api.env (propietario root, permisos 600) y completar.
# NUNCA subir el archivo real al repositorio.

# Base de datos PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/rutas
DB_USER=rutas
DB_PASSWORD=CAMBIAR

# Secreto para firmar los tokens: mínimo 32 bytes. Generar con: openssl rand -base64 48
JWT_SECRET=CAMBIAR
JWT_EXPIRACION=PT2H

# El administrador no se configura aquí: se crea con db-scripts/05_usuario_admin.sql.

# Imágenes: la carpeta que Nginx sirve en /uploads/. En producción las sirve Nginx, no Spring Boot.
UPLOADS_DIR=/var/www/viaja/uploads
SERVE_UPLOADS=false

# Mismo origen detrás de Nginx: sin CORS. La API solo escucha en el equipo local.
CORS_ORIGINS=
SERVER_ADDRESS=127.0.0.1
PORT=8080
